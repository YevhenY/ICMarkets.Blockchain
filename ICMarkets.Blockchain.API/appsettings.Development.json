{
  "EnableSync": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft.AspNetCore": "Debug",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [ "*" ],
    "AllowCredentials": false,
    "PreflightMaxAgeSeconds": 600
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=blockchain.sqlite"
  }
}
